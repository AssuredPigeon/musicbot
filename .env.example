# ============================================================
#  MusicBot - Ejemplo de variables de entorno
#  Copia este archivo como ".env" y rellena tus valores reales
# ============================================================

# Token del bot de Discord (obténlo en https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here

# Prefijo del bot (por defecto "!")
BOT_PREFIX=!

# Credenciales de Spotify (obtenlas en https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# URL de la base de datos (por defecto SQLite local)
DATABASE_URL=sqlite:///musicbot.db

# ─── OpenAI Whisper API (opcional) ───────────────────────────────────────────
# Por defecto el bot usa Whisper LOCAL (gratis, sin internet).
# Si quieres usar la API de pago de OpenAI cambia WHISPER_USE_API a true
# y rellena tu OPENAI_API_KEY.
WHISPER_USE_API=false
OPENAI_API_KEY=your_openai_api_key_here

# Endpoint HTTP interno /transcription (opcional; sin este token el endpoint permanece deshabilitado)
TRANSCRIPTION_API_TOKEN=change_me_to_a_long_random_secret
